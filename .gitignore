#--------------------------------------
!/info/
!/lib/
!/plugin/
!/skel/
!/t/
!/tools/
/tools/*/node_modules/

#--------------------------------------
# public directory
#--------------------------------------
!/pub/
/pub/*
!/pub/.gitkeep
!/pub/assets/

#--------------------------------------
# private directory
#--------------------------------------
!/__cache/index.html

!/data/index.html

!/skel.local/README.txt

#--------------------------------------
# ignore files
#--------------------------------------
/info/textparser_site_tags.txt
/plugin/@3rd-party/
