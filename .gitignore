#--------------------------------------
# ignore default
#--------------------------------------
/*

# VSCode config
!.vscode/*.json

# github files
!/.github

#--------------------------------------
# root files
#--------------------------------------
!/lyndbaum.cgi
!/lyndbaum.fcgi
!/lyndbaum.user.cgi.sample
!/.git-hook/
!/README.md
!/CLAUDE.md
!/docs/

