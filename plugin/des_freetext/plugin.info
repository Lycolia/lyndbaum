*sample_html=<<HTML
<div class="side-module">
<div class="side-module-title">フリー入力</div>
<div class="side-module-body">
テキストやHTMLを自由に入力できます。
</div>
</div>
HTML


*module_html=<<HTML
<$ps = v.load_plgset('<@this>')>
<div class="<@if(ps.class eq '', 'side-module', ps.class)><@if(ps.text_centering, ' center')>" data-title="<@ps.title>" data-module-name="<@this>" id="<@id>">
<@ifexec(!ps.title_none, begin)>
<div class="side-module-title"><@if(ps.title ne '',ps.title ,'テキストを入力できます。')></div>
<$end>
<@if(!ps.body_none,  #'<div class="side-module-body">\n')>
<@if(ps.free_txt ne '', ps.free_txt, '（自由に入力できます）')>
<@if(!ps.body_none,  #'</div> <!-- side-module-body -->\n')>
</div> <!-- End of module -->
HTML

