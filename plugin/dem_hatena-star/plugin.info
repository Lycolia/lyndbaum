EVENTS

*sample_html=<<HTML
<div id="<@id>">
記事にはてなスターを表示
</div>
HTML

*module_html=<<HTML
<div class="display-none" id="<@id>" data-module-name="<@this>">
記事にはてなスターを表示
<@ifexec(!art_sample_mode, begin)>
<$v.regist_post_html(exec(begin))>
<script>
var Hatena;
if (!Hatena) Hatena = {};
if (!Hatena.Star) Hatena.Star = {};
(function() {
var container = 'h1';
<@ifexec(v.load_plgset('<@this>', 'position') eq 'footer', begin)>
// 記事の下に出す。星を入れるdivを、共有ボタンがあればその前、無ければ記事の下の末尾に作る
container = '.hatena-star-box';
document.querySelectorAll('article.article').forEach(function(art) {
	var box = document.createElement('div');
	box.className = 'hatena-star-box';
	var sb = art.querySelector('.social-buttons');
	if (sb) {
		sb.parentNode.insertBefore(box, sb);
	} else {
		(art.querySelector('div.body-footer') || art).appendChild(box);
	}
});
<$end>
Hatena.Star.SiteConfig = {
	entryNodes: {
		'article.article': {
			uri: 'h1 a.title',
			title: 'h1 a.title',
			container: container
		}
	}
};
})();
</script>
<$end>
<$end>
</div>
HTML
