*sample_html=<<HTML
<div class="dem-module" id="<@id>">
サイトの説明が入ります。
</div>
HTML


*module_html=<<HTML
<@> サイトの説明の改行（<br>）は、設定「改行」にチェックが無ければ出さない
<$txt = s.description_txt>
<$ifexec(!v.load_plgset('<@this>', 'br'), begin)><$replace_dest(txt, '(?i)<br\b[^>]*>', '')><$end>
<div class="dem-module" data-module-name="<@this>" id="<@id>">
<@txt || '（サイトの説明が設定されていません。）'>
</div> <!-- End of module -->
HTML
