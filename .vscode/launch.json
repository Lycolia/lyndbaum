{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "lyndbaum.cgi",
      "type": "perl",
      "request": "launch",
      "program": "${workspaceFolder}/lyndbaum.cgi",
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "GATEWAY_INTERFACE": "CGI/1.1",
