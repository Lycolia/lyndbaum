[Unit]
Description=lyndbaum daemon
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/lyndbaum
# /run/lyndbaum/を作る。ソケットをドキュメントルートの外に置くため
RuntimeDirectory=lyndbaum
ExecStart=/usr/bin/perl /var/www/lyndbaum/lyndbaum.fcgi /run/lyndbaum/lyndbaum.sock 10 100
Restart=always

[Install]
WantedBy=multi-user.target
