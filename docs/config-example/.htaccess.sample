# Lyndbaumの.htaccessの見本。根元に.htaccessという名前でコピーする
#
# ・mod_rewriteが必要。使えないサーバーでは、この設定を読むところでエラーになる
# ・Optionsは書かない。指定できないレンタルサーバーでは、サイト全体がエラーになる。
#   VPSなどでは、Apacheの設定に書く（apache.conf）

# 使用メモリ量の制限
# RLimitMem 268435456

RewriteEngine	On

# 非公開のフォルダ。公開するのはpub/だけ
RewriteRule	^(?:__cache|data|docs|info|lib|plugin|skel|skel\.local|t)(?:/|$)	-	[F]

# ドットで始まるもの（.git/、.vscode/など）
# ・pub/は除く。サムネイルが.thumbnail/の下にある
# ・.well-known/は除く。SSL証明書の発行や更新で読まれることがある
RewriteRule	^(?!pub/|\.well-known/)(?:.*/)?\.	-	[F]

# 設定ファイル（lyndbaum.conf.cgiなど）
RewriteRule	^lyndbaum\.(?:conf|env)\.cgi	-	[F]

# ファイルが無いURLは、lyndbaum.cgiに渡す
RewriteCond	%{REQUEST_FILENAME}	!-f
RewriteRule	^(.*)$			lyndbaum.cgi/$1	[L]
